{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/expenses", "destination": "/app.html" },
    { "source": "/expenses/", "destination": "/app.html" }
  ]
}